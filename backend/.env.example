# Standalone Backend Database Configuration (Stored on the backend server, NEVER on the website/client)

# Option A: Standalone Server Database (Default, zero-setup, stored locally on the backend server)
DATABASE_URL="file:./dev.db"

# Option B: Standalone External PostgreSQL Server (e.g. via docker compose up -d or cloud PostgreSQL)
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/competitor_blog_spy?schema=public"

PORT=4000
TARGET_DELAY_SECONDS=300
DEFAULT_CONCURRENCY=10
DEFAULT_CHECK_INTERVAL_MINUTES=5
NODE_ENV=development
